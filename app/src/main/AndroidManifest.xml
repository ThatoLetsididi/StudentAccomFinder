<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.studentaccomfinder">

    <!-- Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Storage - Use older permission for API 24 compatibility -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentAccomFinder">

        <!-- Login launcher (first screen) -->
        <activity
            android:name="com.example.studentaccomfinder.ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.studentaccomfinder.MainActivity"
            android:exported="false" />

        <!-- Registration screen -->
        <activity
            android:name="com.example.studentaccomfinder.ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name="com.example.studentaccomfinder.ui.student.StudentDashboardActivity"
            android:exported="false" />

        <activity
            android:name="com.example.studentaccomfinder.ui.student.BrowseListingsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.studentaccomfinder.ui.student.MyReservationsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.studentaccomfinder.ui.student.PaymentActivity"
            android:exported="false" />

        <activity
            android:name="com.example.studentaccomfinder.ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.studentaccomfinder.ui.provider.ProviderDashboardActivity"
            android:exported="false" />

        <activity
            android:name="com.example.studentaccomfinder.ui.provider.AddListingActivity"
            android:exported="false" />

        <activity
            android:name="com.example.studentaccomfinder.ui.provider.ManageListingsActivity"
            android:exported="false" />

    </application>

</manifest>